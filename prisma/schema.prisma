generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  fullName        String?
  email           String           @unique
  passwordHash    String?
  gender          Gender           @default(UNSPECIFIED)
  weightUnit      WeightUnit       @default(KG)
  authProvider    Provider         @default(LOCAL)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  customExercises Exercise[]       @relation("CustomExercises")
  refreshTokens   RefreshToken[]
  routines        Routine[]
  workouts        WorkoutSession[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id               String            @id @default(uuid())
  name             String
  primaryMuscle    String
  secondaryMuscles String[]
  category         String
  videos           Json?
  thumbnails       Json?
  instructions     Json?
  userId           String?
  user             User?             @relation("CustomExercises", fields: [userId], references: [id])
  routineExercises RoutineExercise[]
  workoutExercises WorkoutExercise[]
}

model Routine {
  id                 String            @id @default(uuid())
  name               String
  notes              String?
  automaticRestTimer Boolean           @default(true)
  userId             String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id])
  exercises          RoutineExercise[]
  workouts           WorkoutSession[]
}

model RoutineExercise {
  id                String   @id @default(uuid())
  routineId         String
  exerciseId        String
  order             Int
  targetSets        Int      @default(1)
  targetReps        String?
  targetTimeSeconds Int?
  targetDistance    Float?
  restSeconds       Int?
  exercise          Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  routine           Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
}

model WorkoutSession {
  id          String            @id @default(uuid())
  userId      String
  routineId   String?
  startTime   DateTime          @default(now())
  endTime     DateTime?
  durationSec Int?
  volumeKg    Float             @default(0)
  notes       String?
  createdAt   DateTime          @default(now())
  exercises   WorkoutExercise[]
  routine     Routine?          @relation(fields: [routineId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
}

model WorkoutExercise {
  id         String         @id @default(uuid())
  sessionId  String
  exerciseId String
  order      Int
  notes      String?
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sets       WorkoutSet[]
}

model WorkoutSet {
  id                String          @id @default(uuid())
  workoutExerciseId String
  setNumber         Int
  weightKg          Float?
  reps              Int?
  timeSeconds       Int?
  distance          Float?
  isCompleted       Boolean         @default(false)
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum WeightUnit {
  KG
  LBS
}

enum Provider {
  LOCAL
  GOOGLE
  APPLE
}
