    {
      "name": "3. Routines",
      "description": "Manage workout routine templates. GET endpoints now include PR (personal record) and estimated 1RM for each exercise based on the user's workout history.",
      "item": [
        {
          "name": "Get All Routines",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/routines",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routines"
              ]
            },
            "description": "Fetch all routines for the authenticated user.\n\nEach exercise in the response includes:\n- **pr** (Personal Record): The actual heaviest weight lifted — `{ weight, reps, date }`. `null` if never performed.\n- **est1RM** (Estimated One Rep Max): Theoretical max for a single rep via Epley formula. `null` if never performed.\n- **weightUnit**: The user's preferred unit (KG or LBS).\n- **lastPerformedAt**: Timestamp of the most recent workout using this routine."
          }
        },
        {
          "name": "Get Routine By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/routines/routine-id-here",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routines",
                "routine-id-here"
              ]
            },
            "description": "Fetch a single routine by ID.\n\nEach exercise in the response includes:\n- **pr** (Personal Record): The actual heaviest weight lifted — `{ weight, reps, date }`. `null` if never performed.\n- **est1RM** (Estimated One Rep Max): Theoretical max for a single rep via Epley formula. `null` if never performed.\n- **weightUnit**: The user's preferred unit (KG or LBS)."
          }
        },
        {
          "name": "Create Routine",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Core Work\",\n  \"notes\": \"Focus on breathing and form.\",\n  \"automaticRestTimer\": true,\n  \"exercises\": [\n    { \"exerciseId\": \"0489\", \"targetTimeSeconds\": 60 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/routines",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routines"
              ]
            },
            "description": "Create a new routine.\n\n**Body fields:**\n- **name** (required): Routine name.\n- **notes** (optional): Free-text notes.\n- **automaticRestTimer** (optional, default: true): If true, the app auto-starts a rest timer between sets.\n- **exercises** (optional): Array of `{ exerciseId, targetSets, targetReps, targetTimeSeconds, targetDistance, restSeconds, order }`."
          }
        },
        {
          "name": "Update Routine",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Core Work V2\",\n  \"notes\": \"Increased time for planks.\",\n  \"automaticRestTimer\": false,\n  \"exercises\": [\n    { \"exerciseId\": \"0489\", \"targetTimeSeconds\": 90 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/routines/routine-id-here",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routines",
                "routine-id-here"
              ]
            },
            "description": "Update an existing routine. Replaces all exercises atomically (delete + recreate in a transaction)."
          }
        },
        {
          "name": "Delete Routine",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/routines/routine-id-here",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routines",
                "routine-id-here"
              ]
            },
            "description": "Delete a routine and all its exercises (cascade)."
          }
        }
      ]
    },
